    HOST_IPS = {
        getgenv().CustomMCPHost,          -- กำหนดเองผ่าน getgenv().CustomMCPHost ได้
        "172.20.10.13",                   -- Hotspot / Mobile LAN IP
        "127.0.0.1",                      -- Localhost IPv4 (PC)
        "localhost",                      -- Localhost Hostname
        "10.0.2.2",                       -- Gateway IP สำหรับ Android Emulator (LDPlayer/MuMu/Bluestacks)
        "192.168.1.100",
        "192.168.1.50",
    },

    MAX_RETRIES     = 60,                 -- จำนวนรอบในการพยายามเชื่อมต่อ
    RETRY_DELAY     = 0.4,                -- ดีเลย์ระหว่างรอบ (วินาที)
    FAST_PROBE_WAIT = 0.8,                -- Timeout สูงสุดในการเช็คแต่ละ Host (วินาที)
    SHOW_NOTIFY     = true,               -- แสดง In-Game Notification หรือไม่
    ENABLE_WATCHDOG = true,               -- ตรวจจับการหลุดแล้ว Reconnect อัตโนมัติ

